    {
      "id": 7,
      "type": "timeseries",
      "title": "$symbol: giá đóng cửa 1 phút",
      "description": "Đổi cặp ở biến 'Cặp' phía trên. Đường dọc là tin có impact >= 2 (bật/tắt ở mục Annotations).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT minute AS time, close AS \"$symbol\"\nFROM market.candles_1m\nWHERE symbol = '$symbol' AND $__timeFilter(minute)\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "% thay đổi từ đầu khoảng thời gian, mọi tài sản",
      "description": "Cùng một thang % để so coin với vàng (PAXG = token 1 ounce vàng). Gộp tối đa khoảng 600 điểm mỗi đường.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT time, symbol, (close / first_value(close) OVER (PARTITION BY symbol ORDER BY time) - 1) * 100 AS pct\nFROM\n(\n    SELECT toStartOfInterval(minute, INTERVAL greatest(1, intDiv(dateDiff('minute', $__fromTime, $__toTime), 600)) MINUTE) AS time,\n           symbol, argMax(close, minute) AS close\n    FROM market.candles_1m\n    WHERE $__timeFilter(minute)\n    GROUP BY symbol, time\n)\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "displayName": "${__field.labels.symbol}",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tin liên quan theo giờ, theo loại",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfHour(published_at) AS time, category, count() AS news\nFROM market.news_enriched FINAL\nWHERE relevant AND $__timeFilter(published_at)\nGROUP BY time, category\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
