            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sentiment trung bình theo giờ (tin liên quan)",
      "description": "-1 xấu cho tài sản rủi ro, 1 tốt. Nhãn do model 7B gán, chỉ xem xu hướng.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfHour(published_at) AS time,\n       avg(sentiment) AS \"sentiment TB\",\n       avg(sentiment * impact) / 3 AS \"sentiment x impact\"\nFROM market.news_enriched FINAL\nWHERE relevant AND $__timeFilter(published_at)\nGROUP BY time\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "decimals": 2,
          "custom": {
            "showPoints": "always",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Lợi nhuận TB sau tin, theo sentiment ($symbol)",
      "description": "So với dòng 'mọi thời điểm' (lợi nhuận TB của mọi phút trong khoảng thời gian đang xem). Chênh lệch nhỏ hoặc ít mẫu thì không có ý nghĩa thống kê. Tương quan, không phải nhân quả, không phải khuyến nghị.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT '0 mọi thời điểm' AS nhom,\n       count() AS mau,\n       round(avg(nullIf(c15, 0) / close - 1) * 100, 4)  AS ret_15m,\n       round(avg(nullIf(c60, 0) / close - 1) * 100, 4)  AS ret_1h,\n       round(avg(nullIf(c240, 0) / close - 1) * 100, 4) AS ret_4h,\n       round(countIf(c60 > close) / countIf(c60 > 0) * 100, 1) AS tang_1h\nFROM\n(\n    SELECT close,\n           leadInFrame(close, 15)  OVER w AS c15,\n           leadInFrame(close, 60)  OVER w AS c60,\n           leadInFrame(close, 240) OVER w AS c240\n    FROM market.candles_1m\n    WHERE symbol = '$symbol' AND $__timeFilter(minute)\n    WINDOW w AS (ORDER BY minute ROWS BETWEEN CURRENT ROW AND 240 FOLLOWING)\n)\nUNION ALL\nSELECT multiIf(sentiment <= -0.2, '1 tin xấu', sentiment >= 0.2, '3 tin tốt', '2 trung tính') AS nhom,\n       count() AS mau,\n       round(avg(ret_15m) * 100, 4),\n       round(avg(ret_1h) * 100, 4),\n       round(avg(ret_4h) * 100, 4),\n       round(countIf(ret_1h > 0) / count(ret_1h) * 100, 1)\nFROM market.news_reaction\nWHERE symbol = '$symbol' AND $__timeFilter(published_at)\nGROUP BY nhom\nORDER BY nhom",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "ret_.*|tang_1h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tang_1h"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "% lần tăng sau 1h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mau"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "số mẫu"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "nhom"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "nhóm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Lợi nhuận TB sau tin, theo loại tin ($symbol)",
      "description": "bien_dong_1h = trung bình |lợi nhuận 1h|: loại tin nào đi kèm giá dao động mạnh, bất kể chiều.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT category,\n       count() AS mau,\n       round(avg(sentiment), 2) AS sentiment_tb,\n       round(avg(ret_15m) * 100, 4) AS r_15m,\n       round(avg(ret_1h) * 100, 4) AS r_1h,\n       round(avg(ret_4h) * 100, 4) AS r_4h,\n       round(avg(abs(ret_1h)) * 100, 4) AS bien_dong_1h\nFROM market.news_reaction\nWHERE symbol = '$symbol' AND $__timeFilter(published_at)\nGROUP BY category\nORDER BY mau DESC",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "r_.*|bien_dong_1h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bien_dong_1h"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "|biến động 1h|"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mau"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "số mẫu"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sentiment_tb"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "sentiment TB"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Giá sau từng tin liên quan ($symbol)",
      "description": "Mốc là giá đóng cửa phút trước khi tin ra. Ô trống: chưa đủ thời gian. Bấm tiêu đề để mở bài.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT published_at, feed, category, sentiment, impact, title,\n       round(ret_15m * 100, 3) AS r_15m, round(ret_1h * 100, 3) AS r_1h, round(ret_4h * 100, 3) AS r_4h, url\nFROM market.news_reaction\nWHERE symbol = '$symbol' AND $__timeFilter(published_at)\nORDER BY published_at DESC\nLIMIT 200",
          "format": 1,
